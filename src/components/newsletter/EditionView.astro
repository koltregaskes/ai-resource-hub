---
/**
 * One daily edition: lead story, the day in 60 seconds, numbered stories and a
 * category filter that works without sign-in. Shared by /newsletter/ (today)
 * and /newsletter/YYYY-MM-DD/.
 *
 * Analytics hooks for the later in-house analytics task: the root carries
 * data-edition-date, each story data-story-id and data-category, and outbound
 * links data-outbound="story".
 */
import type { Edition, EditionStory } from '../../data/newsletter-editions';
import { NEWS_CATEGORIES } from '../../data/news-categories';
import { storyPathForUrl } from '../../data/news-stories';
import NewsletterSignup from '../NewsletterSignup.astro';

interface Props {
  edition: Edition;
  previous?: { date: string; shortLabel: string } | null;
  next?: { date: string; shortLabel: string } | null;
  weekId: string;
}

const { edition, previous = null, next = null, weekId } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const classFor = (id: string) => NEWS_CATEGORIES.find((category) => category.id === id)?.className ?? '';
const all: EditionStory[] = [edition.lead, ...edition.stories];
const timeFormatter = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit' });
const tagLabel: Record<string, string> = { benchmark: 'Benchmark', pricing_change: 'Pricing', open_source: 'Open source' };
---

<div class="airh-edition" data-edition-date={edition.date}>
  <header class="border-b border-(--color-border) pb-6">
    <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-(--color-accent)">
      Daily edition{edition.isToday ? ' · updating through the day' : ''}
    </p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-black font-display text-(--color-text-primary)">{edition.dateLabel}</h1>
    <p class="mt-3 text-sm text-(--color-text-secondary)">
      {`${all.length} ${all.length === 1 ? 'story' : 'stories'} from ${edition.sourceCount} ${edition.sourceCount === 1 ? 'source' : 'sources'}${edition.totalAvailable > all.length ? `, the top ${all.length} of ${edition.totalAvailable}` : ''}.`}
      {edition.isToday && ' The page rebuilds every hour, so new stories can still land today.'}
    </p>
    <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Edition navigation">
      {previous && <a class="text-(--color-accent) hover:text-(--color-accent-hover)" href={`${base}newsletter/${previous.date}/`}>&larr; {previous.shortLabel}</a>}
      {next && <a class="text-(--color-accent) hover:text-(--color-accent-hover)" href={`${base}newsletter/${next.date}/`}>{next.shortLabel} &rarr;</a>}
      <a class="text-(--color-text-secondary) hover:text-(--color-text-primary)" href={`${base}newsletter/week/${weekId}/`}>This week's round-up</a>
      <a class="text-(--color-text-secondary) hover:text-(--color-text-primary)" href={`${base}newsletter/archive/`}>All editions</a>
      <a class="text-(--color-text-secondary) hover:text-(--color-text-primary)" href={`${base}newsletter/rss.xml`}>RSS</a>
    </nav>
  </header>

  <section class="mt-8" aria-labelledby="sixty-seconds">
    <h2 id="sixty-seconds" class="text-xs font-semibold uppercase tracking-[0.22em] text-(--color-text-muted)">The day in 60 seconds</h2>
    <p class="mt-3 text-lg leading-relaxed text-(--color-text-primary)">{edition.sixtySeconds.text}</p>
    {!edition.sixtySeconds.editorial && (
      <p class="mt-2 text-xs text-(--color-text-muted)">Built from the day's headlines and counts. No editor has written this one up yet.</p>
    )}
  </section>

  <section class="mt-8" aria-label="Filter by category">
    <div class="flex flex-wrap items-center gap-2" data-edition-filter>
      <span class="mr-1 text-xs font-semibold uppercase tracking-[0.18em] text-(--color-text-muted)">Show</span>
      <button type="button" data-filter="all" aria-pressed="true" class="airh-chip rounded-full border border-(--color-border) px-3 py-1 text-xs font-semibold text-(--color-text-primary)">All</button>
      {edition.categoryCounts.map((entry) => (
        <button type="button" data-filter={entry.id} aria-pressed="false" class="airh-chip rounded-full border border-(--color-border) px-3 py-1 text-xs font-semibold text-(--color-text-secondary)">
          {entry.label} <span class="text-(--color-text-muted)">{entry.count}</span>
        </button>
      ))}
    </div>
    <p class="mt-2 hidden text-sm text-(--color-text-muted)" data-filter-empty>No stories in the picked categories today.</p>
  </section>

  <ol class="mt-6 space-y-4" data-edition-stories>
    {all.map((story, index) => (
      <li
        class:list={[
          'rounded-2xl border bg-(--color-bg-secondary) p-5',
          index === 0 ? 'border-(--color-accent)/50' : 'border-(--color-border)',
        ]}
        data-story-id={story.id}
        data-category={story.category}
      >
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="font-mono font-semibold text-(--color-text-muted)">{index === 0 ? 'Lead' : String(index).padStart(2, '0')}</span>
          <span class={`rounded px-1.5 py-0.5 font-medium ${classFor(story.category)}`}>{story.categoryLabel}</span>
          {story.company && <span class="rounded bg-(--color-bg-tertiary) px-1.5 py-0.5 font-medium text-(--color-text-secondary)">{story.company}</span>}
          {story.tags.map((tag) => <span class="rounded border border-(--color-border) px-1.5 py-0.5 text-(--color-text-muted)">{tagLabel[tag] ?? tag}</span>)}
          <span class="text-(--color-text-muted)">{story.source} · {timeFormatter.format(new Date(story.publishedAt))} UK</span>
        </div>
        <h3 class:list={['mt-2 font-bold text-(--color-text-primary)', index === 0 ? 'text-2xl' : 'text-lg']}>
          <a href={story.url} rel="noopener" target="_blank" data-outbound="story" class="hover:text-(--color-accent)">{story.title}</a>
        </h3>
        {story.summary && <p class="mt-2 text-sm leading-relaxed text-(--color-text-secondary)">{story.summary}</p>}
        {story.whyItMatters && (
          <p class="mt-3 text-sm text-(--color-text-primary)"><span class="font-semibold">Why it matters:</span> {story.whyItMatters}</p>
        )}
        <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
          <a href={story.url} rel="noopener" target="_blank" data-outbound="story" class="text-(--color-accent) hover:text-(--color-accent-hover)">Read it at {story.source} &rarr;</a>
          {storyPathForUrl(story.url) && (
            <a href={`${base}${storyPathForUrl(story.url)}`} data-story-page class="text-(--color-text-secondary) hover:text-(--color-text-primary)">More on the Hub</a>
          )}
        </p>
      </li>
    ))}
  </ol>

  {!edition.hasEditorialNotes && (
    <p class="mt-6 text-xs text-(--color-text-muted)">
      "Why it matters" notes appear once an editor has reviewed the day. This edition doesn't have them yet, so each story shows its source's own summary.
    </p>
  )}

  <div class="mt-10">
    <NewsletterSignup variant="inline" />
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-edition-filter]');
    if (!root) return;
    var buttons = Array.prototype.slice.call(root.querySelectorAll('[data-filter]'));
    var stories = Array.prototype.slice.call(document.querySelectorAll('[data-edition-stories] > li'));
    var empty = document.querySelector('[data-filter-empty]');
    var KEY = 'airh:edition-categories';
    var valid = buttons.map(function (button) { return button.getAttribute('data-filter'); }).filter(function (id) { return id !== 'all'; });
    var clean = function (list) {
      return list.filter(function (id, index) { return valid.indexOf(id) !== -1 && list.indexOf(id) === index; });
    };
    // Shareable state: ?c=models,agents picks those; ?c=all (or an explicit
    // empty ?c=) shows everything; no ?c at all falls back to this reader's
    // saved picks. Clicking a chip writes the choice back to the URL.
    var picked = [];
    try {
      var params = new URLSearchParams(location.search);
      if (params.has('c')) {
        var fromUrl = params.get('c') || '';
        picked = fromUrl === 'all' ? [] : clean(fromUrl.split(','));
      } else {
        picked = clean((localStorage.getItem(KEY) || '').split(','));
      }
    } catch (_) {}

    function syncUrl() {
      try {
        var url = new URL(location.href);
        url.searchParams.set('c', picked.length ? picked.join(',') : 'all');
        history.replaceState(history.state, '', url.pathname + '?' + url.searchParams.toString().replace(/%2C/gi, ',') + url.hash);
      } catch (_) {}
    }

    function apply() {
      var shown = 0;
      stories.forEach(function (li) {
        var visible = picked.length === 0 || picked.indexOf(li.getAttribute('data-category')) !== -1;
        li.hidden = !visible;
        if (visible) shown++;
      });
      buttons.forEach(function (button) {
        var id = button.getAttribute('data-filter');
        var on = id === 'all' ? picked.length === 0 : picked.indexOf(id) !== -1;
        button.setAttribute('aria-pressed', on ? 'true' : 'false');
        button.classList.toggle('airh-chip-on', on);
      });
      if (empty) empty.classList.toggle('hidden', shown > 0);
      try { localStorage.setItem(KEY, picked.join(',')); } catch (_) {}
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var id = button.getAttribute('data-filter');
        if (id === 'all') picked = [];
        else if (picked.indexOf(id) === -1) picked.push(id);
        else picked = picked.filter(function (value) { return value !== id; });
        apply();
        syncUrl();
      });
    });
    apply();
  })();
</script>

<style>
  .airh-chip-on {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg-primary);
  }
  .airh-chip-on span {
    color: inherit;
  }
</style>
