---
import { additionalPractitioner } from '../../data/practitioner-additional';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<section id="practitioner-more" class="mb-14 scroll-mt-24">
  <h2 class="text-2xl font-bold text-(--color-text-primary) mb-4">More practitioner guides: evidence and calculations</h2>
  <p class="text-(--color-text-secondary) mb-6">These examples use stated assumptions. They are not model measurements. Each entry names its frozen data and an offline script; run the script with <code>--check</code> to reproduce it. Documentation is linked and briefly paraphrased, not collected as a dataset. No additional data licence is claimed.</p>
  <div class="space-y-4">{additionalPractitioner.map(e => (
    <article id={e.id} class="rounded-2xl border border-(--color-border) bg-(--color-bg-card) p-5 scroll-mt-24">
      <h3 class="text-lg font-bold text-(--color-text-primary)"><a href={`${base}blog/${e.slug}/`}>{e.title}</a></h3>
      <p class="text-(--color-text-secondary) my-3">{e.formula}</p>
      <p class="text-sm text-(--color-text-secondary) mb-3"><strong>Assumptions:</strong> {e.assumptions}</p>
      <p class="text-sm text-(--color-text-secondary) mb-3"><strong>Limits:</strong> {e.limits}</p>
      <ul class="text-sm text-(--color-text-secondary) space-y-2">{e.sources.map(s => <li><a href={s.url} class="text-(--color-accent) underline" rel="noopener">{s.title}</a>, read {s.checked}: {s.claim}</li>)}</ul>
      <p class="text-xs text-(--color-text-muted) mt-3">Code: <code>{e.code}</code>. Frozen tables: <code>{e.data}</code>.</p>
    </article>
  ))}</div>
</section>
