---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLLMModels } from '../../data/llm-models';
import modelsLatest from '../../../public/data/models-latest.json';

const models = getLLMModels();
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

function formatPrice(price: number): string {
  if (price === 0) return 'Free';
  if (price < 0.01) return `$${price.toFixed(4)}`;
  if (price < 1) return `$${price.toFixed(3)}`;
  return `$${price.toFixed(2)}`;
}

// Standard (non-batch) list prices only, from the dated model export.
const priceRange = models
  .filter((m) => m.inputPrice > 0 && !/\(batch\)/i.test(m.name))
  .sort((a, b) => {
    const aCost = (a.inputPrice + 3 * a.outputPrice) / 4;
    const bCost = (b.inputPrice + 3 * b.outputPrice) / 4;
    return aCost - bCost;
  });
const cheapest = priceRange[0];
const mostExpensive = priceRange[priceRange.length - 1];
const exportDate = new Date(modelsLatest.generated).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const outputDearer = priceRange.filter((m) => m.outputPrice > m.inputPrice).length;

// Worked examples: half the tokens in, half out, at the lowest and highest listed rates.
const costAt = (tokens: number, m: { inputPrice: number; outputPrice: number }) =>
  ((tokens / 2) * m.inputPrice + (tokens / 2) * m.outputPrice) / 1_000_000;
function formatCost(v: number): string {
  if (v < 0.001) return '< $0.001';
  if (v < 0.01) return `$${v.toFixed(3)}`;
  return `$${v.toFixed(2)}`;
}
const tasks = [
  { task: 'Quick question & answer', tokens: 500 },
  { task: 'Email draft', tokens: 1_500 },
  { task: 'Blog post (1,000 words)', tokens: 3_000 },
  { task: 'Summarise a 10-page document', tokens: 5_000 },
  { task: 'Analyse a full book', tokens: 100_000 },
];
---

<BaseLayout
  title="Understanding AI Pricing: Tokens, Tiers & Value — The AI Resource Hub"
  description="What tokens are, why input and output are priced separately, free and paid plans, and how to estimate your costs from dated list prices."
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <nav class="text-xs text-(--color-text-muted) mb-4" aria-label="Breadcrumb">
      <a href={base} class="hover:text-(--color-text-secondary) transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href={`${base}guides/`} class="hover:text-(--color-text-secondary) transition-colors">Guides</a>
      <span class="mx-2">/</span>
      <span class="text-(--color-text-secondary)">Understanding AI Pricing</span>
    </nav>

    <header class="mb-10">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs px-2 py-0.5 rounded-full bg-green-500/10 text-green-400">Beginner</span>
        <span class="text-xs text-(--color-text-muted)">7 min read</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-(--color-text-primary) mb-4">
        Understanding AI Pricing
      </h1>
      <p class="text-lg text-(--color-text-secondary)">
        Tokens, tiers, input and output: AI pricing can seem confusing.
        Here's everything you need to understand how much AI costs and how to get the best value.
      </p>
    </header>

    <div class="space-y-8">
      <section>
        <h2 class="text-2xl font-bold text-(--color-text-primary) mb-4">What Are Tokens?</h2>
        <p class="text-(--color-text-secondary) leading-relaxed mb-4">
          AI models don't read words. They read <strong class="text-(--color-text-primary)">tokens</strong>.
          OpenAI's rule of thumb for English is that a token is about 4 characters, or roughly three quarters of a word (<a href="https://help.openai.com/en/articles/4936856-what-are-tokens-and-how-to-count-them" rel="noopener" class="text-(--color-accent)">source</a>). Other languages and code can use more. Here's what that means in practice:
        </p>

        <div class="grid sm:grid-cols-3 gap-3 mb-4">
          <div class="p-4 rounded-xl bg-(--color-bg-card) border border-(--color-border) text-center">
            <p class="text-2xl font-bold text-(--color-accent)">~750</p>
            <p class="text-sm text-(--color-text-muted)">words per 1,000 tokens</p>
          </div>
          <div class="p-4 rounded-xl bg-(--color-bg-card) border border-(--color-border) text-center">
            <p class="text-2xl font-bold text-(--color-accent)">~4</p>
            <p class="text-sm text-(--color-text-muted)">characters per token</p>
          </div>
          <div class="p-4 rounded-xl bg-(--color-bg-card) border border-(--color-border) text-center">
            <p class="text-2xl font-bold text-(--color-accent)">~1.3</p>
            <p class="text-sm text-(--color-text-muted)">tokens per word (average)</p>
          </div>
        </div>

        <p class="text-(--color-text-secondary) leading-relaxed">
          So if you send a 500-word email to an AI and it writes a 300-word reply, that's roughly
          670 input tokens and 400 output tokens.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-(--color-text-primary) mb-4">Input and Output Are Priced Separately</h2>
        <p class="text-(--color-text-secondary) leading-relaxed mb-4">
          Most AI APIs charge separately for input tokens (what you send) and output tokens (what the AI writes back).
          In the export built on {exportDate}, output is priced higher than input for {outputDearer} of the {priceRange.length} language models with a standard list price.
        </p>

        

        {cheapest && mostExpensive && (
          <p class="text-(--color-text-secondary) leading-relaxed">
            In the same export, the cheapest model on a blended standard price is {cheapest.name} at <strong class="text-(--color-success)">{formatPrice(cheapest.inputPrice)}</strong> per
            million input tokens, and the dearest is {mostExpensive.name} at <strong class="text-(--color-danger)">{formatPrice(mostExpensive.inputPrice)}</strong> per
            million input tokens, about {Math.round(mostExpensive.inputPrice / cheapest.inputPrice)} times as much. These are the prices we last recorded, not current quotes, so check the provider before you budget.
          </p>
        )}
      </section>

      <section>
        <h2 class="text-2xl font-bold text-(--color-text-primary) mb-4">How Much Does Typical Usage Cost?</h2>
        <p class="text-(--color-text-secondary) leading-relaxed mb-4">
          Here are worked examples at the lowest and highest standard rates in the export built on {exportDate}, assuming half the tokens are input and half output. The build date isn't when each price was recorded: rows read from OpenRouter's feed carry a last-read time on their model page, and most prices copied from a provider's page have no recorded date at all. Token counts are rough, and real bills depend on the model and provider.
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-(--color-border)">
                <th class="text-left py-3 px-3 text-(--color-text-muted) font-medium">Task</th>
                <th class="text-right py-3 px-3 text-(--color-text-muted) font-medium">~Tokens</th>
                <th class="text-right py-3 px-3 text-(--color-text-muted) font-medium">Lowest listed rate</th>
                <th class="text-right py-3 px-3 text-(--color-text-muted) font-medium">Highest listed rate</th>
              </tr>
            </thead>
            <tbody>
              {tasks.map((t) => (
                <tr class="border-b border-(--color-border)/50 last:border-0">
                  <td class="py-3 px-3 text-(--color-text-primary)">{t.task}</td>
                  <td class="py-3 px-3 text-right text-(--color-text-secondary)">{t.tokens.toLocaleString('en-GB')}</td>
                  <td class="py-3 px-3 text-right text-(--color-success)">{cheapest ? formatCost(costAt(t.tokens, cheapest)) : 'n/a'}</td>
                  <td class="py-3 px-3 text-right text-(--color-text-primary)">{mostExpensive ? formatCost(costAt(t.tokens, mostExpensive)) : 'n/a'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-(--color-text-primary) mb-4">Consumer Subscriptions vs API Pricing</h2>
        <p class="text-(--color-text-secondary) leading-relaxed mb-4">
          There are two ways to pay for AI:
        </p>

        <div class="grid sm:grid-cols-2 gap-4 mb-4">
          <div class="p-5 rounded-xl bg-(--color-bg-card) border border-(--color-border)">
            <h3 class="font-semibold text-(--color-text-primary) mb-3">Subscription (Consumer)</h3>
            <ul class="text-sm text-(--color-text-secondary) space-y-2">
              <li><a href="https://openai.com/chatgpt/pricing/" rel="noopener" class="text-(--color-accent)">ChatGPT plans</a> (OpenAI)</li>
              <li><a href="https://claude.com/pricing" rel="noopener" class="text-(--color-accent)">Claude plans</a> (Anthropic)</li>
              <li><a href="https://gemini.google/subscriptions/" rel="noopener" class="text-(--color-accent)">Gemini plans</a> (Google)</li>
            </ul>
            <p class="text-xs text-(--color-text-muted) mt-3">
              A fixed monthly fee with usage limits set by each plan. Prices and limits change, so check the provider's page. Best for individual users who want a simple chat interface.
            </p>
          </div>
          <div class="p-5 rounded-xl bg-(--color-bg-card) border border-(--color-border)">
            <h3 class="font-semibold text-(--color-text-primary) mb-3">API (Developer)</h3>
            <ul class="text-sm text-(--color-text-secondary) space-y-2">
              <li><strong>Pay per token:</strong> exact usage billing</li>
              <li><strong>Multiple models:</strong> choose price/quality tradeoff</li>
              <li><strong>Full control:</strong> temperature, system prompts, etc.</li>
            </ul>
            <p class="text-xs text-(--color-text-muted) mt-3">
              Pay only for what you use. Best for developers building applications, or power users who want fine-grained control.
            </p>
          </div>
        </div>

        <p class="text-sm text-(--color-text-muted)">
          See the API prices we last recorded: <a href={`${base}compare/llm/`} class="text-(--color-accent) hover:text-(--color-accent-hover) transition-colors">LLM Comparison Table</a>
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-(--color-text-primary) mb-4">How to Get the Best Value</h2>
        <div class="space-y-3">
          <div class="p-4 rounded-lg bg-(--color-bg-card) border border-(--color-border)">
            <h3 class="font-semibold text-(--color-text-primary) text-sm mb-1">1. Use the right model for the job</h3>
            <p class="text-sm text-(--color-text-secondary)">Don't use the most expensive model for simple tasks. Use a cheap model for routine work and reserve premium models for hard problems.</p>
          </div>
          <div class="p-4 rounded-lg bg-(--color-bg-card) border border-(--color-border)">
            <h3 class="font-semibold text-(--color-text-primary) text-sm mb-1">2. Write concise prompts</h3>
            <p class="text-sm text-(--color-text-secondary)">Every word in your prompt costs tokens. Be specific but not repetitive. Remove filler text.</p>
          </div>
          <div class="p-4 rounded-lg bg-(--color-bg-card) border border-(--color-border)">
            <h3 class="font-semibold text-(--color-text-primary) text-sm mb-1">3. Set max output limits</h3>
            <p class="text-sm text-(--color-text-secondary)">Tell the AI to keep responses concise. "In 3 sentences..." saves tokens compared to getting a 5-paragraph essay.</p>
          </div>
          <div class="p-4 rounded-lg bg-(--color-bg-card) border border-(--color-border)">
            <h3 class="font-semibold text-(--color-text-primary) text-sm mb-1">4. Check benchmark value</h3>
            <p class="text-sm text-(--color-text-secondary)">Benchmark value compares the source-backed evaluated benchmark average with blended price. Models without enough rankable evidence are excluded, which is most of them at the moment.</p>
          </div>
        </div>
      </section>
    </div>

    <div class="mt-8">
      <a
        href={`${base}guides/`}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-(--color-bg-tertiary) text-(--color-text-secondary) hover:text-(--color-text-primary) hover:bg-(--color-bg-hover) transition-colors text-sm"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All Guides
      </a>
    </div>
  </article>
</BaseLayout>
