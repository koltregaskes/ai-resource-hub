---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { blogPosts } from '../../data/blog-posts';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const posts = blogPosts;

const categoryColours: Record<string, string> = {
  Explainer: 'bg-blue-500/20 text-blue-400',
  Analysis: 'bg-purple-500/20 text-purple-400',
  Comparison: 'bg-green-500/20 text-green-400',
  Beginner: 'bg-yellow-500/20 text-yellow-400',
  Essay: 'bg-orange-500/20 text-orange-300',
  News: 'bg-pink-500/20 text-pink-400',
};
---

<BaseLayout
  title="Blog — The AI Resource Hub"
  description="Articles, analysis, and explainers about AI models, benchmarks, pricing trends, and the AI industry."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <nav class="text-xs text-(--color-text-muted) mb-4" aria-label="Breadcrumb">
      <a href={base} class="hover:text-(--color-text-secondary) transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-(--color-text-secondary)">Blog</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-(--color-text-primary) mb-3">
        Blog
      </h1>
      <p class="text-(--color-text-secondary) max-w-2xl">
        Analysis, explainers, and commentary on AI models, benchmarks, and pricing trends.
      </p>
    </div>

    <div class="mb-8 rounded-[28px] border border-(--color-border-accent) bg-(--color-accent-glow) p-6">
      <p class="text-[11px] uppercase tracking-[0.28em] text-(--color-accent)">Release Coverage</p>
      <h2 class="mt-2 text-2xl font-black text-(--color-text-primary)">Need the latest launch briefs before they become blog posts?</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-(--color-text-secondary)">
        The new release desk tracks fresh model launches, gathers official sources and benchmark signal, and prepares editor-ready briefs before they are turned into public posts.
      </p>
      <a href={`${base}new/`} class="mt-5 inline-flex items-center gap-2 text-sm text-(--color-accent) transition-colors hover:text-(--color-accent-hover)">
        Open the model release desk
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <div class="space-y-4">
      {posts.map((post) => (
        <a
          href={`${base}blog/${post.slug}/`}
          class="block p-6 rounded-xl bg-(--color-bg-card) border border-(--color-border) hover:border-(--color-accent)/40 transition-all group"
        >
          <div class="flex items-center gap-3 mb-2">
            <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${categoryColours[post.type] ?? 'bg-gray-500/20 text-gray-400'}`}>
              {post.type}
            </span>
            <span class="text-xs text-(--color-text-muted)">{new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <span class="text-xs text-(--color-text-muted)">{post.readTime} read</span>
          </div>
          <h2 class="text-xl font-bold text-(--color-text-primary) group-hover:text-(--color-accent) transition-colors mb-2">
            {post.title}
          </h2>
          <p class="text-sm text-(--color-text-secondary)">{post.description}</p>
        </a>
      ))}
    </div>
  </section>

  <NewsletterSignup variant="card" />
</BaseLayout>
