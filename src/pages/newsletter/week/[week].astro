---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getWeeklyRoundups, type WeeklyRoundup } from '../../../data/newsletter-editions';
import { NEWS_CATEGORIES } from '../../../data/news-categories';

export function getStaticPaths() {
  return getWeeklyRoundups().map((week) => ({ params: { week: week.id }, props: { week } }));
}

interface Props {
  week: WeeklyRoundup;
}

const { week } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const classFor = (id: string) => NEWS_CATEGORIES.find((category) => category.id === id)?.className ?? '';
---

<BaseLayout
  title={`AI weekly round-up, ${week.label} | The AI Resource Hub`}
  description={`The week's AI stories in one place: ${week.storyCount} stories across ${week.editions.length} daily editions.`}
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-(--color-accent)">Weekly round-up</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-black font-display text-(--color-text-primary)">{week.label}</h1>
    <p class="mt-3 text-sm text-(--color-text-secondary)">
      {week.storyCount} {week.storyCount === 1 ? 'story' : 'stories'} across {week.editions.length} daily {week.editions.length === 1 ? 'edition' : 'editions'}:
      {' '}{week.categoryCounts.map((entry) => `${entry.count} ${entry.label}`).join(', ')}.
    </p>

    <h2 class="mt-8 text-xs font-semibold uppercase tracking-[0.22em] text-(--color-text-muted)">Top stories</h2>
    <p class="mt-1 text-xs text-(--color-text-muted)">Each day's lead story first, then the highest-ranked of the rest.</p>
    <ol class="mt-4 space-y-3">
      {week.topStories.map((story, index) => (
        <li class="rounded-xl border border-(--color-border) bg-(--color-bg-secondary) p-4" data-story-id={story.id} data-category={story.category}>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-mono font-semibold text-(--color-text-muted)">{String(index + 1).padStart(2, '0')}</span>
            <span class={`rounded px-1.5 py-0.5 font-medium ${classFor(story.category)}`}>{story.categoryLabel}</span>
            {story.company && <span class="rounded bg-(--color-bg-tertiary) px-1.5 py-0.5 text-(--color-text-secondary)">{story.company}</span>}
            <span class="text-(--color-text-muted)">{story.source}</span>
          </div>
          <a href={story.url} rel="noopener" target="_blank" data-outbound="story" class="mt-1 block font-semibold text-(--color-text-primary) hover:text-(--color-accent)">{story.title}</a>
          {story.summary && <p class="mt-1 text-sm text-(--color-text-secondary)">{story.summary}</p>}
        </li>
      ))}
    </ol>

    <h2 class="mt-10 text-xs font-semibold uppercase tracking-[0.22em] text-(--color-text-muted)">The daily editions</h2>
    <ul class="mt-3 space-y-2">
      {week.editions.map((edition) => (
        <li>
          <a class="text-sm text-(--color-accent) hover:text-(--color-accent-hover)" href={`${base}newsletter/${edition.date}/`}>{edition.dateLabel}</a>
          <span class="text-sm text-(--color-text-secondary)">: {edition.lead.title}</span>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm"><a class="text-(--color-text-secondary) hover:text-(--color-text-primary)" href={`${base}newsletter/archive/`}>&larr; All editions and weeks</a></p>
  </section>
</BaseLayout>
