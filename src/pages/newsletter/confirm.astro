---
/**
 * Landing page for the newsletter Worker's redirects:
 *   ?status=check-email  after sign-up without JavaScript
 *   ?status=confirmed    after the double opt-in click (with &manage=<signed link>)
 *   ?status=expired      bad or old confirmation link
 * Static page; a small inline script picks the message.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const apiOrigin = (() => {
  try {
    return import.meta.env.PUBLIC_NEWSLETTER_API ? new URL(import.meta.env.PUBLIC_NEWSLETTER_API).origin : '';
  } catch {
    return '';
  }
})();
---

<BaseLayout
  title="Daily edition sign-up | The AI Resource Hub"
  description="Confirming your AI Resource Hub daily edition sign-up."
  robots="noindex"
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24" data-api-origin={apiOrigin}>
    <div data-state="check-email">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-(--color-text-primary)">Check your inbox</h1>
      <p class="mt-3 text-(--color-text-secondary)">We've sent a confirmation email. Click the link in it and your daily edition starts the next morning. Nothing arrives until you do.</p>
      <p class="mt-2 text-sm text-(--color-text-muted)">Nothing there after a few minutes? Check spam, or sign up again.</p>
    </div>
    <div data-state="confirmed" hidden>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-(--color-text-primary)">You're in</h1>
      <p class="mt-3 text-(--color-text-secondary)">Your first daily edition arrives tomorrow morning. Every email has a link to change your categories and a one-click unsubscribe.</p>
      <p class="mt-3 hidden" data-manage-wrap><a data-manage-link class="text-(--color-accent) hover:text-(--color-accent-hover)" href="#">Change your categories now</a></p>
    </div>
    <div data-state="expired" hidden>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-(--color-text-primary)">That link has expired</h1>
      <p class="mt-3 text-(--color-text-secondary)">Confirmation links work for 7 days. Sign up again and we'll send a fresh one.</p>
    </div>
    <div class="mt-10 flex flex-wrap gap-4 text-sm">
      <a href={`${base}newsletter/`} class="text-(--color-accent) hover:text-(--color-accent-hover)">Read today's edition</a>
      <a href={`${base}newsletter/archive/`} class="text-(--color-text-secondary) hover:text-(--color-text-primary)">All editions</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(location.search);
      var status = params.get('status');
      if (status !== 'confirmed' && status !== 'expired') return;
      document.querySelectorAll('[data-state]').forEach(function (el) {
        el.hidden = el.getAttribute('data-state') !== status;
      });
      var origin = document.querySelector('[data-api-origin]').getAttribute('data-api-origin');
      var manage = params.get('manage');
      if (status === 'confirmed' && manage && origin) {
        try {
          var url = new URL(manage);
          if (url.origin === origin && url.pathname === '/manage') {
            document.querySelector('[data-manage-link]').href = url.href;
            document.querySelector('[data-manage-wrap]').classList.remove('hidden');
          }
        } catch (_) {}
      }
    })();
  </script>
</BaseLayout>
